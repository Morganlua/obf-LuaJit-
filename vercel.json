{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/mgvt",
      "destination": "/api/mgvt.js"
    },
    {
      "source": "/api/umpc",
      "destination": "/api/umpc.js"
    },
    {
      "source": "/api/lv",
      "destination": "/api/lv.js"
    },
    {
      "source": "/api/social",
      "destination": "/api/social.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ]
}